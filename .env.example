# EdgeBrain environment configuration
# Copy to .env and adjust as needed.

# --- App ---
DEBUG=true

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Security ---
API_ENABLED=false
API_KEY=
API_KEY_READ=
API_KEY_WRITE=

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://edgebrain:edgebrain@postgres:5432/edgebrain

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MQTT ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_KEEPALIVE=60

# --- Simulator ---
SIM_INTERVAL_MS=2000
SIM_TEMP_BASE=24.0
SIM_TEMP_DRIFT=0.3
SIM_ENERGY_BASE=120.0
SIM_SPIKE_PROB=0.01
SIM_MOTION_PROB=0.3

# --- AI Engine ---
ANOMALY_WINDOW=100
ANOMALY_Z_THRESHOLD=2.0

# --- Alerting ---
TEMP_CRITICAL=40.0
TEMP_HIGH=30.0
TEMP_NORMAL=25.0
ENERGY_SPIKE=500.0
NO_MOTION_TIMEOUT_S=300

# --- Device Heartbeat ---
DEVICE_HEARTBEAT_TIMEOUT_S=60

# --- Data Retention ---
DATA_RETENTION_DAYS=90
DATA_CLEANUP_ENABLED=true
DATA_CLEANUP_INTERVAL_HOURS=24
